{
  "name": "fe-phi-vo",
  "version": "1.0.0",
  "private": true,
  "description": "HTML and CSS implementation of the FE Internship Figma website",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3"
  },
  "type": "module"
}
